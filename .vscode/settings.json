{
  "typescript.tsdk": "node_modules/typescript/lib",
  "editor.formatOnSave": true,
  "files.exclude": {
    "dist": false,
    "node_modules": true
  },
  "search.exclude": {
    "dist/**": true,
    "node_modules/**": true
